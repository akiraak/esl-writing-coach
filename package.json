{
  "name": "esl-writing-coach",
  "version": "0.1.0",
  "description": "ESL の授業の opinion paragraph を、学びながら書くためのツール（自分専用・ローカル）",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web --silent",
    "build:web": "esbuild src/browser/main.ts --bundle --format=iife --target=es2022 --outfile=dist/browser/app.js --log-level=warning",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.web.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dropbox:check": "npm run build --silent && node --env-file-if-exists=.env dist/scripts/dropbox-check.js",
    "dropbox:smoke": "npm run build --silent && node --env-file-if-exists=.env dist/scripts/dropbox-smoke.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
