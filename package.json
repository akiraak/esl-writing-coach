{
  "name": "esl-writing-coach",
  "version": "0.1.0",
  "description": "ESL の授業の opinion paragraph を、学びながら書くためのツール（自分専用・ローカル）",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web --silent",
    "build:web": "esbuild src/browser/main.ts --bundle --format=iife --target=es2022 --outfile=dist/browser/app.js --log-level=warning",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.web.json",
    "test": "tsc -p tsconfig.test.json && node --disable-warning=ExperimentalWarning --test \"dist-test/test/**/*.test.js\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:backup": "npm run build --silent && node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/scripts/db-backup.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  }
}
