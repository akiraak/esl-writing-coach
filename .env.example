# .env にコピーして値を入れる。.env はコミットしない（.gitignore 済み）

# サーバの待ち受けポート（127.0.0.1 だけで待ち受ける）
PORT=3016

# DB のファイル（データの本体）。既定はリポジトリの data/esl-writing.db。相対パスはリポジトリから。
# Dropbox で同期しているフォルダには置かない
# ESL_DB_PATH=data/esl-writing.db

# --- Dropbox API（DB のバックアップだけに使う。無ければバックアップしない） ---
# Dropbox アプリは daily-note と共用する（2026-11-08 決定）。
# daily-note の .env の DROPBOX_APP_KEY / DROPBOX_APP_SECRET / DROPBOX_REFRESH_TOKEN をそのまま写す。
# リフレッシュトークンを取り直すときは daily-note 側で `npm run dropbox:auth` を流す
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# バックアップは <DROPBOX_ROOT>/backups/ に置く（Dropbox ルートからのパス。末尾に / を付けない）。既定は /akira/Documents/esl-writing
DROPBOX_ROOT=/akira/Documents/esl-writing

# --- AI の採点（Anthropic API） ---
# Anthropic Console の API キー。無ければ採点だけが使えない（ほかの機能は動く）
ANTHROPIC_API_KEY=
